# DRUM MVP — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to Git!
#
# ⚠️ DRUM MVP runs in Stripe TEST mode only. The app refuses sk_live_ keys.

# ============================================
# DEMO MODE (investor demo without credentials)
# DEMO_MODE=true -> in-memory database (data/demo-state.json),
#                   simulated Stripe escrow/capture, everything marked [DEMO].
# ============================================
DEMO_MODE=true

# ============================================
# TELEGRAM BOT
# Get token from @BotFather (https://t.me/BotFather)
# Leave empty + DEMO_MODE=true to run dashboard-only (no bot)
# ============================================
TELEGRAM_BOT_TOKEN=

# Webhook URL (for production). Leave empty for polling (development)
TELEGRAM_WEBHOOK_URL=

# ============================================
# STRIPE CONNECT (TEST MODE KEYS ONLY)
# Get keys from https://dashboard.stripe.com/test/apikeys
# ============================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Connect Express — for carrier payouts
# Leave empty until you have a confirmed Connect account
STRIPE_CONNECT_CLIENT_ID=

# ============================================
# AIRTABLE
# Get token from https://airtable.com/create/tokens
# Base ID from https://airtable.com/api
# (ignored when DEMO_MODE=true)
# ============================================
AIRTABLE_API_KEY=patXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Table names in Airtable
AIRTABLE_USERS_TABLE=Users
AIRTABLE_SHIPMENTS_TABLE=Shipments
AIRTABLE_TRUST_EVENTS_TABLE=Trust Events
AIRTABLE_CARBON_LEDGER_TABLE=Carbon Ledger

# ============================================
# QR CODES (goqr.me — free tier, no key needed)
# ============================================
QR_API_URL=https://api.qrserver.com/v1/create-qr-code/

# ============================================
# OPS CHANNEL (Telegram channel ID for ops notifications)
# Create a private channel, add bot as admin, get ID
# ============================================
OPS_CHANNEL_ID=

# ============================================
# APP
# ============================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ============================================
# PRICING SPLIT (percent of captured amount)
# 80% carrier / 15% DRUM / 5% insurance pool
# ============================================
FACILITATION_FEE_PERCENT=15
INSURANCE_PREMIUM_PERCENT=5
CARRIER_PAYOUT_PERCENT=80

# ============================================
# CARBON LEDGER (GHG Protocol Scope 3, Cat. 4)
# Baseline: dedicated courier van, kg CO2e per km
# Marginal share: fraction of baseline attributed to a parcel
# riding in an already-travelling car with an empty trunk
# ============================================
CO2_BASELINE_KG_PER_KM=0.18
CO2_MARGINAL_KG_PER_KM=0.005

